{
    "name": "laravel/react-starter-kit",
    "description": "The skeleton application for the Laravel framework.",
    "license": "MIT",
    "type": "project",
    "keywords": [
        "laravel",
        "framework"
    ],
    "require": {
        "php": "^8.5",
        "aws/aws-sdk-php": "^3.400",
        "brick/money": "^0.14.0",
        "inertiajs/inertia-laravel": "^3.0",
        "laravel/chisel": "^0.1.0",
        "laravel/fortify": "^1.37.2",
        "laravel/framework": "^13.17",
        "laravel/nightwatch": "^1.30",
        "laravel/tinker": "^3.0",
        "laravel/wayfinder": "^0.1.14",
        "saloonphp/laravel-plugin": "^4.3",
        "saloonphp/pagination-plugin": "^2.3",
        "saloonphp/saloon": "^4.0"
    },
    "require-dev": {
        "barryvdh/laravel-ide-helper": "^3.7",
        "driftingly/rector-laravel": "^2.5",
        "ergebnis/composer-normalize": "^2.52",
        "fakerphp/faker": "^1.24",
        "larastan/larastan": "^3.9",
        "laravel/boost": "^2.4",
        "laravel/pail": "^1.2.5",
        "laravel/pao": "^1.0.6",
        "laravel/pint": "^1.27",
        "laravel/sail": "^1.53",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^8.9.3",
        "pestphp/pest": "^5.2",
        "pestphp/pest-plugin-agent": "^5.0",
        "pestphp/pest-plugin-browser": "^5.0",
        "pestphp/pest-plugin-laravel": "^5.0",
        "pestphp/pest-plugin-phpstan": "^5.2",
        "pestphp/pest-plugin-rector": "^5.0",
        "pestphp/pest-plugin-type-coverage": "^5.0",
        "phpstan/extension-installer": "^1.4",
        "phpstan/phpstan-phpunit": "^2.0",
        "phpstan/phpstan-strict-rules": "^2.0",
        "phpunit/phpunit": "^13.2.4",
        "rector/rector": "^2.5",
        "tomasvotruba/type-coverage": "^2.2"
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "config": {
        "allow-plugins": {
            "ergebnis/composer-normalize": true,
            "pestphp/pest-plugin": true,
            "php-http/discovery": true,
            "phpstan/extension-installer": true
        },
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "audit": {
            "ignore-abandoned": ["symplify/rule-doc-generator-contracts"]
        }
    },
    "extra": {
        "laravel": {
            "dont-discover": [],
            "installer": {
                "post-create-project": []
            }
        }
    },
    "scripts": {
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force"
        ],
        "pre-package-uninstall": [
            "Illuminate\\Foundation\\ComposerScripts::prePackageUninstall"
        ],
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi",
            "@php -r \"file_exists('database/database.sqlite') || touch('database/database.sqlite');\"",
            "@php artisan migrate --graceful --ansi"
        ],
        "ci:check": [
            "Composer\\Config::disableProcessTimeout",
            "pnpm run lint:check",
            "pnpm run fmt:check",
            "pnpm run types:check",
            "@test"
        ],
        "demo": [
            "Composer\\Config::disableProcessTimeout",
            "@php artisan config:clear --ansi",
            "pnpm run build:ssr",
            "@putenv DEMO_PRESENT=1",
            "pest tests/Browser/DemoJourneyTest.php --headed"
        ],
        "dev": [
            "Composer\\Config::disableProcessTimeout",
            "@php artisan dev"
        ],
        "fix": [
            "@fmt",
            "@refactor"
        ],
        "fmt": [
            "pint --parallel"
        ],
        "fmt:check": [
            "pint --parallel --test"
        ],
        "lint": [
            "phpstan analyse"
        ],
        "lint:arch": [
            "pest --testsuite=Arch"
        ],
        "refactor": [
            "rector process"
        ],
        "refactor:check": [
            "rector process --dry-run"
        ],
        "setup": [
            "composer install",
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\"",
            "@php artisan key:generate",
            "@php artisan migrate --force",
            "pnpm install",
            "pnpm run build"
        ],
        "test": [
            "@php artisan config:clear --ansi",
            "@fmt:check",
            "@refactor:check",
            "@lint",
            "@lint:arch",
            "@php artisan test --ci --fail-on-risky --fail-on-warning --fail-on-deprecation --fail-on-notice --fail-on-phpunit-deprecation"
        ],
        "test:browser": [
            "Composer\\Config::disableProcessTimeout",
            "@php artisan config:clear --ansi",
            "pnpm run build:ssr",
            "pest tests/Browser"
        ],
        "test:types": [
            "pest --type-coverage --min=100"
        ],
        "test:coverage": [
            "Composer\\Config::disableProcessTimeout",
            "@php artisan config:clear --ansi",
            "php -d pcov.enabled=1 vendor/bin/pest --parallel --coverage --min=90 --passthru-php=\"'-d' 'pcov.enabled=1'\""
        ],
        "test:tia": [
            "Composer\\Config::disableProcessTimeout",
            "@putenv XDEBUG_MODE=coverage",
            "php -d pcov.enabled=1 vendor/bin/pest --tia --locally"
        ],
        "test:tia:fresh": [
            "Composer\\Config::disableProcessTimeout",
            "@putenv XDEBUG_MODE=coverage",
            "php -d pcov.enabled=1 vendor/bin/pest --tia --locally --fresh"
        ],
        "test:mutation": [
            "Composer\\Config::disableProcessTimeout",
            "@php artisan config:clear --ansi",
            "@putenv PAO_DISABLE=1",
            "@putenv XDEBUG_MODE=coverage",
            "pest --mutate --everything --covered-only --parallel --min=65"
        ],
        "types:generate": [
            "@php artisan wayfinder:generate --with-form"
        ]
    },
    "$schema": "https://getcomposer.org/schema.json"
}
