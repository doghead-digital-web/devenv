        "@tailwindcss/vite": "^4.3.3",
        "@types/react": "^19.3.0",
        "@types/react-dom": "^19.3.0",
        "@vitejs/plugin-react": "^5.2.0",
        "class-variance-authority": "^0.7.1",
        "clsx": "^2.1.1",
        "concurrently": "^9.2.4",
        "globals": "^15.15.0",
        "input-otp": "^1.5.0",
        "laravel-vite-plugin": "^3.2.0",
        "lucide-react": "^0.475.0",
        "motion": "^12.43.0",
        "next-themes": "^0.4.6",
        "react": "^19.3.0",
        "react-dom": "^19.3.0",
