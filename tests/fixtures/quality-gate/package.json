{
    "$schema": "https://www.schemastore.org/package.json",
    "private": true,
    "type": "module",
    "scripts": {
        "build": "tsc && vite build",
        "build:ssr": "tsc && vite build && vite build --ssr",
        "dev": "vite",
        "fmt": "prettier --write resources/ '*.config.ts'",
        "fmt:check": "prettier --check resources/ '*.config.ts'",
        "lint": "eslint . --fix",
        "lint:check": "eslint .",
        "test:unit": "vitest run",
        "types:check": "tsc --noEmit"
    },
    "devDependencies": {
        "@eslint/js": "^9.39.5",
        "@laravel/vite-plugin-wayfinder": "^0.1.10",
        "@shadcn/lint": "^0.1.5",
